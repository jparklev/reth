# /etc/default/witness-emit-uploader
#
# Uploader-specific config. Reload via:
#   systemctl daemon-reload && systemctl restart witness-uploader

# 32-byte ed25519 seed (raw bytes, mode 0400 or 0600, owner root).
SIGNING_KEY=/var/lib/reth/relay-indexer/writer.key

# S3-compatible endpoint.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=reth-spike-fsn1
S3_REGION=fsn1
S3_PREFIX=witnesses/exex

# Writer ID; must match the pubkey published at
# s3://<bucket>/writer-keys/<writer-id>.pub
WRITER_ID=primary

# Where the ExEx drops files; matches WITNESS_EMIT_DIR in the node env file.
WITNESS_EMIT_DIR=/var/lib/witness-emit/inbox

UPLOADER_CURSOR=/var/lib/witness-emit/uploader-cursor.json
UPLOADER_STATS=/var/lib/witness-emit/uploader-stats.jsonl

# Prometheus /metrics listener — Prometheus must scrape this address.
METRICS_ADDR=127.0.0.1:19003
