#!/usr/bin/env bash
# Launcher for witness-uploader.service.
#
# Sources /etc/default/relay-l2 for HETZNER_* credentials and remaps them to
# the AWS_* env vars that the SDK actually reads.

set -euo pipefail

: "${HETZNER_ACCESS_KEY:?HETZNER_ACCESS_KEY required (from /etc/default/relay-l2)}"
: "${HETZNER_SECRET_KEY:?HETZNER_SECRET_KEY required (from /etc/default/relay-l2)}"
: "${SIGNING_KEY:?SIGNING_KEY required}"
: "${S3_ENDPOINT:?S3_ENDPOINT required}"
: "${S3_BUCKET:?S3_BUCKET required}"
: "${S3_PREFIX:?S3_PREFIX required}"
: "${WITNESS_EMIT_DIR:?WITNESS_EMIT_DIR required}"
: "${UPLOADER_CURSOR:?UPLOADER_CURSOR required}"
: "${UPLOADER_STATS:?UPLOADER_STATS required}"

WRITER_ID="${WRITER_ID:-primary}"
S3_REGION="${S3_REGION:-fsn1}"
METRICS_ADDR="${METRICS_ADDR:-127.0.0.1:19003}"

export AWS_ACCESS_KEY_ID="${HETZNER_ACCESS_KEY}"
export AWS_SECRET_ACCESS_KEY="${HETZNER_SECRET_KEY}"
export RUST_LOG="${RUST_LOG:-info}"

# R2 dual-write is opt-in: the binary checks all four R2_* env vars and
# enables only if all four are set. Optional vars are passed as empty so the
# clap `env = "…"` reader sees an empty string (which then fails the
# Option<String> consume) and the feature stays off.
exec /usr/local/bin/witness-uploader \
    --emit-dir "${WITNESS_EMIT_DIR}" \
    --signing-key "${SIGNING_KEY}" \
    --writer-id "${WRITER_ID}" \
    --endpoint "${S3_ENDPOINT}" \
    --bucket "${S3_BUCKET}" \
    --region "${S3_REGION}" \
    --prefix "${S3_PREFIX}" \
    --stats "${UPLOADER_STATS}" \
    --cursor "${UPLOADER_CURSOR}" \
    --metrics-addr "${METRICS_ADDR}"
    # R2_ENDPOINT / R2_BUCKET / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY /
    # R2_REGION are picked up automatically from the EnvironmentFile via
    # clap's `env = "..."` annotations on each flag. Nothing more needed.
