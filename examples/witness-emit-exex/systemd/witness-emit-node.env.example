# /etc/default/witness-emit-node
#
# Producer-specific configuration for reth-witness-emit-node.service.
# Reload after edits: `systemctl daemon-reload && systemctl restart reth-witness-emit-node`.

# MDBX datadir. Must already exist and have CLI=mainnet-compatible chain spec.
DATADIR=/var/lib/reth/reth-bucket-import-test-v6

# Engine API JWT secret shared with the consensus client driving this node.
JWT_PATH=/var/lib/reth/reth-bucket-import-test-v6/jwt.hex

# Where the ExEx writes <num>-<hash>.witness.zst files.
WITNESS_EMIT_DIR=/var/lib/witness-emit/inbox
WITNESS_STATS=/var/lib/witness-emit/exex-stats.jsonl

# Ports — all chosen to NOT collide with prod reth (8545/8547/8551/9001/30303).
HTTP_PORT=18555
WS_PORT=18556
AUTHRPC_PORT=18557
P2P_PORT=30404
METRICS_PORT=19002

# Trusted-peer config: in this single-host topology the ExEx node lives in the
# same datacenter as prod reth and pulls blocks from it directly. This avoids
# the "starving on public discovery" problem we saw on cold start (2200+
# outbound attempts, 0 peers). The enode is operational config, not a secret;
# fetch it from prod via:
#   curl -s -X POST -H 'Content-Type: application/json' \
#     --data '{"jsonrpc":"2.0","method":"admin_nodeInfo","id":1,"params":[]}' \
#     http://127.0.0.1:8545 | jq -r .result.enode
PROD_ENODE=enode://e5e1d53d3af68570d142e1755941299132a07f1eff740270644dccad538a0d553182e3a9dac6c0cab4128e46bc10b02eeaf4938f52a582362f19f393f39b7f45@127.0.0.1:30303

# Optional overrides:
# CHAIN=mainnet
# RUST_LOG=info,witness_emit=info
# MIN_FREE_GB=30
# MIN_INBOX_FREE_GB=5
