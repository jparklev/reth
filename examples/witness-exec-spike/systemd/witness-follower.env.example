# /etc/default/witness-follower-<NAME>
#
# Per-instance configuration for witness-follower@<NAME>.service.
# Each reader gets its own copy of this file with disjoint cursor/jsonl/metrics.

S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=reth-spike-fsn1
S3_MANIFEST=witnesses/exex/head.json

# OPTIONAL: per-block signature verification.
# WITNESS_PUBKEY=/etc/witness-emit/writer.key.pub

# OPTIONAL: public CDN base URL — much faster than authenticated S3 fetches
# when the bucket is configured with public-read ACLs.
# WITNESS_BASE_URL=https://fsn1.your-objectstorage.com/reth-spike-fsn1

# Per-instance state — point each reader at its own subdirectory.
FOLLOWER_CURSOR=/var/lib/witness-followers/reader-a/cursor.json
FOLLOWER_JSONL=/var/lib/witness-followers/reader-a/events.jsonl

# Per-instance metrics port. Allocate disjoint ports for each reader.
FOLLOWER_METRICS_ADDR=127.0.0.1:19110

# Polling cadence + jitter (in milliseconds). Jitter prevents readers
# scraping in lock-step when several share a host.
POLL_MS=1500
JITTER_MS=500

# Simulate a remote DC by sleeping before each fetch. 800ms ~= a transatlantic
# round-trip. Leave at 0 for a local-DC reader.
FETCH_DELAY_MS=0

# Logical reader name — appears in metrics labels and JSONL "reader" field.
READER_NAME=reader-a
